#!/bin/sh
set -eu

usage() {
    printf 'usage: %s --validate SNAPSHOT_DIRECTORY\n' "$0" >&2
    printf '       %s SNAPSHOT_DIRECTORY STATE_DIRECTORY\n' "$0" >&2
    exit 64
}

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
snapshot=${2:-}
mode=decide
if [ "${1:-}" = --validate ]; then
    [ "$#" -eq 2 ] || usage
    mode=validate
elif [ "$#" -eq 2 ]; then
    snapshot=$1
    state_directory=$2
else
    usage
fi

collection=$snapshot/collection.tsv
cells=$snapshot/cells.tsv
attempts=$snapshot/attempts.tsv
owner_record=$snapshot/owner-record.tsv

for command_name in awk cmp cut grep mkdir mv sha256sum sort; do
    command -v "$command_name" >/dev/null 2>&1 || {
        printf 'cockswain: %s is required\n' "$command_name" >&2
        exit 69
    }
done

for required_file in "$collection" "$cells" "$attempts" "$owner_record"; do
    [ -f "$required_file" ] || {
        printf 'cockswain: missing owner snapshot file: %s\n' "$required_file" >&2
        exit 66
    }
done

digest() {
    sha256sum "$1" | awk '{print $1}'
}

read_value() {
    file=$1
    key=$2
    awk -F '\t' -v wanted="$key" '
        $1 == wanted {
            if (found++) exit 2
            value=$2
        }
        END {
            if (found != 1) exit 1
            print value
        }
    ' "$file"
}

require_value() {
    file=$1
    key=$2
    value=$(read_value "$file" "$key") || {
        printf 'cockswain: missing or duplicate %s in %s\n' "$key" "$file" >&2
        exit 65
    }
    printf '%s\n' "$value"
}

is_count() {
    printf '%s\n' "$1" | awk '$0 ~ /^(0|[1-9][0-9]*)$/ {ok=1} END {exit !ok}'
}

is_sha256() {
    printf '%s\n' "$1" | awk 'length($0)==64 && $0 ~ /^[0-9a-f]+$/ {ok=1} END {exit !ok}'
}

is_commit() {
    printf '%s\n' "$1" | awk 'length($0)==40 && $0 ~ /^[0-9a-f]+$/ {ok=1} END {exit !ok}'
}

awk -F '\t' '
    NF != 2 || $1 == "" || $2 == "" || seen[$1]++ {bad=1}
    END {exit bad}
' "$collection" || {
    echo 'cockswain: malformed owner collection record' >&2
    exit 65
}

[ "$(require_value "$collection" schema)" = cockswain-owner-record-collection-v1 ] || {
    echo 'cockswain: unsupported owner collection schema' >&2
    exit 65
}
[ "$(require_value "$collection" status)" = COMPLETE ] || {
    echo 'cockswain: owner enumeration is not complete' >&2
    exit 65
}
[ "$(require_value "$collection" enumeration_complete)" = yes ] || {
    echo 'cockswain: owner enumeration completion is not established' >&2
    exit 65
}
owner=$(require_value "$collection" owner)
owner_schema=$(require_value "$collection" owner_schema)
owner_revision=$(require_value "$collection" owner_revision)
owner_locator=$(require_value "$collection" owner_locator)
expected_pages=$(require_value "$collection" expected_pages)
observed_pages=$(require_value "$collection" observed_pages)
expected_cells=$(require_value "$collection" expected_cells)
observed_cells=$(require_value "$collection" observed_cells)
expected_attempts=$(require_value "$collection" expected_attempts)
observed_attempts=$(require_value "$collection" observed_attempts)
owner_record_sha256=$(require_value "$collection" owner_record_sha256)
cells_sha256=$(require_value "$collection" cells_sha256)
attempts_sha256=$(require_value "$collection" attempts_sha256)
policy_sha256=$(require_value "$collection" policy_sha256)
profile_sha256=$(require_value "$collection" profile_sha256)

printf '%s\n' "$owner" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || {
    echo 'cockswain: invalid owner identity' >&2; exit 65;
}
[ "$owner_schema" = catfood-android-build-plan-v1 ] || {
    echo 'cockswain: unsupported owner record schema' >&2; exit 65;
}
is_commit "$owner_revision" || { echo 'cockswain: invalid owner revision' >&2; exit 65; }
case "$owner_locator" in *[!A-Za-z0-9._:/@?=+%-]*|'') echo 'cockswain: invalid owner locator' >&2; exit 65 ;; esac
for count in "$expected_pages" "$observed_pages" "$expected_cells" "$observed_cells" "$expected_attempts" "$observed_attempts"; do
    is_count "$count" || { echo 'cockswain: invalid owner enumeration count' >&2; exit 65; }
done
[ "$expected_pages" -gt 0 ] && [ "$expected_pages" = "$observed_pages" ] || {
    echo 'cockswain: partial owner pagination' >&2; exit 65;
}
[ "$expected_cells" = "$observed_cells" ] || {
    echo 'cockswain: owner cell denominator does not match observation count' >&2; exit 65;
}
[ "$expected_attempts" = "$observed_attempts" ] || {
    echo 'cockswain: owner attempt denominator does not match observation count' >&2; exit 65;
}
for expected_digest in "$owner_record_sha256" "$cells_sha256" "$attempts_sha256" "$policy_sha256" "$profile_sha256"; do
    is_sha256 "$expected_digest" || { echo 'cockswain: invalid owner digest' >&2; exit 65; }
done
[ "$(digest "$owner_record")" = "$owner_record_sha256" ] &&
[ "$(digest "$cells")" = "$cells_sha256" ] &&
[ "$(digest "$attempts")" = "$attempts_sha256" ] || {
    echo 'cockswain: owner snapshot bytes changed after enumeration' >&2
    exit 65
}

owner_record_commit=$(awk -F '\t' '$1=="catfood_commit" {n++; value=$2} END {if(n!=1) exit 1; print value}' "$owner_record") || {
    echo 'cockswain: owner record lacks one Cat Food commit' >&2; exit 65;
}
[ "$owner_record_commit" = "$owner_revision" ] || {
    echo 'cockswain: owner ref changed across the scan' >&2; exit 65;
}
[ "$(awk -F '\t' '$1=="schema" {n++; value=$2} END {if(n!=1) exit 1; print value}' "$owner_record")" = "$owner_schema" ] || {
    echo 'cockswain: owner record schema does not match its collection' >&2; exit 65;
}
owner_source=$(awk -F '\t' '$1=="source_sha" {n++; value=$2} END {if(n!=1) exit 1; print value}' "$owner_record") || {
    echo 'cockswain: owner record lacks one source identity' >&2; exit 65;
}
is_commit "$owner_source" || { echo 'cockswain: invalid owner source identity' >&2; exit 65; }
owner_targets=$(awk -F '\t' '
    $0=="target\tdevice\tabi\tobligation\tacceptance" {header++; next}
    header==1 && NF==5 {if(seen[$1]++) bad=1; count++}
    END {if(header!=1 || bad) exit 1; print count+0}
' "$owner_record") || {
    echo 'cockswain: malformed Cat Food owner plan' >&2; exit 65;
}
[ "$owner_targets" = "$expected_cells" ] || {
    echo 'cockswain: owner plan target count does not match cell denominator' >&2; exit 65;
}

cells_header='cell_id\ttarget\tsource_identity\tscope_sha256\tmaterial_sha256\tpolicy_sha256\tprofile_sha256\tacceptance_kind\tstate\tdependency_state\tevidence_kind\tevidence_locator\tevidence_source_identity\tevidence_sha256\tsuperseded_by\tsupersession_evidence_locator\tsupersession_evidence_sha256\treason\tnext_action'
[ "$(sed -n '1p' "$cells")" = "$(printf '%b' "$cells_header")" ] || {
    echo 'cockswain: invalid owner cells header' >&2; exit 65;
}
attempts_header='cell_id\tattempt_id\tobservation\tsource_identity\tmaterial_sha256\tevidence_kind\tevidence_locator\tevidence_sha256\tdetail'
[ "$(sed -n '1p' "$attempts")" = "$(printf '%b' "$attempts_header")" ] || {
    echo 'cockswain: invalid owner attempts header' >&2; exit 65;
}

actual_cells=$(awk 'END {print NR-1}' "$cells")
actual_attempts=$(awk 'END {print NR-1}' "$attempts")
[ "$actual_cells" = "$observed_cells" ] || {
    echo 'cockswain: omitted or extra owner cell' >&2; exit 65;
}
[ "$actual_attempts" = "$observed_attempts" ] || {
    echo 'cockswain: omitted or extra owner attempt' >&2; exit 65;
}

awk -F '\t' -v source="$owner_source" -v material="$owner_record_sha256" \
    -v policy="$policy_sha256" -v profile="$profile_sha256" '
    NR==1 {next}
    NF!=19 {bad="invalid owner cell field width"; exit}
    $1 !~ /^[A-Za-z0-9._:@+\/-]+$/ || seen_id[$1]++ {bad="invalid or duplicate stable cell identity"; exit}
    $2 !~ /^[A-Za-z0-9._+-]+$/ || seen_target[$2]++ {bad="invalid or duplicate owner target"; exit}
    $3!=source {bad="cell source differs from owner source"; exit}
    $4 !~ /^[0-9a-f]{64}$/ {bad="invalid cell scope digest"; exit}
    $5!=material || $6!=policy || $7!=profile {bad="cell material, policy or profile is stale"; exit}
    $8 !~ /^(build|package|install|launch|runtime|physical|unsupported|conditional)$/ {bad="invalid acceptance kind"; exit}
    $9 !~ /^(ACTIONABLE|FAILED|WAITING|HUMAN|COMPLETE|UNSUPPORTED|CONDITIONAL|SUPERSEDED)$/ {bad="invalid cell state"; exit}
    $10 !~ /^(READY|BLOCKED|IN_FLIGHT|UNAVAILABLE|HUMAN_REQUIRED|SATISFIED|NOT_APPLICABLE)$/ {bad="invalid dependency state"; exit}
    $11 !~ /^(-|source|build|package|install|launch|runtime|physical|policy)$/ {bad="invalid evidence kind"; exit}
    $12=="" || $13=="" || $14=="" || $15=="" || $16=="" || $17=="" || $18=="" || $19=="" {bad="empty owner cell field"; exit}
    ($13!="-" && $13!~ /^[0-9a-f]{40}$/) || ($14!="-" && $14!~ /^[0-9a-f]{64}$/) ||
      ($17!="-" && $17!~ /^[0-9a-f]{64}$/) {bad="invalid cell evidence identity"; exit}
    $9=="ACTIONABLE" && $10!="READY" {bad="actionable cell lacks a ready dependency"; exit}
    $9=="FAILED" && !($10=="READY" || $10=="BLOCKED") {bad="failed cell has invalid dependency state"; exit}
    $9=="WAITING" && !($10=="IN_FLIGHT" || $10=="UNAVAILABLE") {bad="waiting cell lacks an unavailable dependency"; exit}
    $9=="HUMAN" && $10!="HUMAN_REQUIRED" {bad="human cell lacks a human-only boundary"; exit}
    $9=="COMPLETE" && ($10!="SATISFIED" || $11=="-" || $12=="-" || $13!=$3 || $14=="-") {
        bad="complete cell lacks current source-bound evidence"; exit
    }
    ($9=="UNSUPPORTED" || $9=="CONDITIONAL") &&
      ($10!="NOT_APPLICABLE" || $11!="-" || $12!="-" || $13!="-" || $14!="-" || $18=="-") {
        bad="unsupported or conditional cell was promoted or lacks a reason"; exit
    }
    $9=="SUPERSEDED" && ($15=="-" || $15==$1 || $16=="-" || $17=="-") {bad="unsupported supersession"; exit}
    $9!="SUPERSEDED" && ($15!="-" || $16!="-" || $17!="-") {bad="supersession evidence on active cell"; exit}
    {scope[$1]=$4; kind[$1]=$8; state[$1]=$9; successor[$1]=$15}
    END {
        if(bad!="") {print "cockswain: " bad > "/dev/stderr"; exit 1}
        for(id in successor) if(successor[id]!="-") {
            next_id=successor[id]
            if(!(next_id in scope) || scope[id]!=scope[next_id] || kind[id]!=kind[next_id]) {
                print "cockswain: supersession changes or omits the accepted scope" > "/dev/stderr"; exit 1
            }
            cursor=next_id
            for(step=0; step<=length(successor); step++) {
                if(cursor==id) {print "cockswain: supersession cycle" > "/dev/stderr"; exit 1}
                if(!(cursor in successor) || successor[cursor]=="-") break
                cursor=successor[cursor]
            }
        }
    }
' "$cells" || exit 65

tab=$(printf '\t')
tail -n +2 "$cells" |
while IFS="$tab" read -r cell_id target cell_source scope material cell_policy cell_profile \
    acceptance state dependency evidence_kind evidence_locator evidence_source evidence_sha \
    superseded_by supersession_locator supersession_sha reason next_action; do
    case "$state" in
        COMPLETE)
            case "$evidence_locator" in
                evidence/*) ;;
                *) printf 'cockswain: complete cell evidence is not locally refreshable: %s\n' "$cell_id" >&2; exit 65 ;;
            esac
            case "$evidence_locator" in *..*|*[!A-Za-z0-9._/+:-]*) echo 'cockswain: unsafe evidence locator' >&2; exit 65 ;; esac
            [ -f "$snapshot/$evidence_locator" ] &&
            [ "$(digest "$snapshot/$evidence_locator")" = "$evidence_sha" ] || {
                printf 'cockswain: complete cell evidence bytes are missing or stale: %s\n' "$cell_id" >&2
                exit 65
            }
            ;;
        SUPERSEDED)
            case "$supersession_locator" in
                evidence/*) ;;
                *) printf 'cockswain: supersession evidence is not locally refreshable: %s\n' "$cell_id" >&2; exit 65 ;;
            esac
            case "$supersession_locator" in *..*|*[!A-Za-z0-9._/+:-]*) echo 'cockswain: unsafe supersession evidence locator' >&2; exit 65 ;; esac
            [ -f "$snapshot/$supersession_locator" ] &&
            [ "$(digest "$snapshot/$supersession_locator")" = "$supersession_sha" ] || {
                printf 'cockswain: supersession evidence bytes are missing or stale: %s\n' "$cell_id" >&2
                exit 65
            }
            ;;
    esac
done

awk -F '\t' -v cells="$cells" '
    FILENAME==cells && FNR>1 {
        known[$1]=1; source[$1]=$3; material[$1]=$5; state[$1]=$9
        evidence_kind[$1]=$11; evidence_locator[$1]=$12; evidence[$1]=$14
        next
    }
    FNR==1 {next}
    NF!=9 {bad="invalid owner attempt field width"; exit}
    !($1 in known) || $2 !~ /^[A-Za-z0-9._:@+\/-]+$/ || seen[$1 SUBSEP $2]++ {bad="invalid or duplicate owner attempt"; exit}
    $3 !~ /^(PASS|FAIL|NOT_RUN|SKIPPED|INTERRUPTED|TIMEOUT)$/ {bad="invalid owner attempt observation"; exit}
    $4 !~ /^[0-9a-f]{40}$/ || $5 !~ /^[0-9a-f]{64}$/ {bad="invalid attempt source or material identity"; exit}
    $6 !~ /^(-|source|build|package|install|launch|runtime|physical|policy)$/ {bad="invalid attempt evidence kind"; exit}
    $7=="" || $8=="" || $9=="" || ($8!="-" && $8!~ /^[0-9a-f]{64}$/) {bad="invalid attempt evidence"; exit}
    {
        count[$1]++
        if($3=="PASS" && $4==source[$1] && $5==material[$1] &&
           $6==evidence_kind[$1] && $7==evidence_locator[$1] && $8==evidence[$1]) matching_pass[$1]=1
    }
    END {
        if(bad!="") {print "cockswain: " bad > "/dev/stderr"; exit 1}
        for(id in known) {
            if(count[id]<1) {print "cockswain: owner cell has no preserved attempt" > "/dev/stderr"; exit 1}
            if(state[id]=="COMPLETE" && !matching_pass[id]) {
                print "cockswain: complete cell lacks a matching preserved PASS attempt" > "/dev/stderr"; exit 1
            }
        }
    }
' "$cells" "$attempts" || exit 65

# Every plan target must have exactly one projected cell, and no projection may
# invent a target outside the owner plan.
awk -F '\t' -v cells="$cells" '
    FILENAME==cells && FNR>1 {projected[$2]++; next}
    $0=="target\tdevice\tabi\tobligation\tacceptance" {rows=1; next}
    rows && NF==5 {owner[$1]++}
    END {
        for(target in owner) if(owner[target]!=1 || projected[target]!=1) exit 1
        for(target in projected) if(owner[target]!=1) exit 1
    }
' "$cells" "$owner_record" || {
    echo 'cockswain: projected cells do not exactly cover the Cat Food owner plan' >&2
    exit 65
}

if [ "$mode" = validate ]; then
    exit 0
fi

mkdir -p "$state_directory/scans"
attempt_ledger=$state_directory/attempt-ledger.tsv
cell_ledger=$state_directory/cell-ledger.tsv

if [ -f "$attempt_ledger" ]; then
    [ "$(sed -n '1p' "$attempt_ledger")" = "$(sed -n '1p' "$attempts")" ] || {
        echo 'cockswain: existing attempt ledger has an incompatible schema' >&2; exit 65;
    }
    tail -n +2 "$attempt_ledger" | while IFS= read -r prior; do
        grep -Fqx "$prior" "$attempts" || {
            echo 'cockswain: a prior owner attempt disappeared on refresh' >&2
            exit 65
        }
    done
fi
if [ -f "$cell_ledger" ]; then
    [ "$(sed -n '1p' "$cell_ledger")" = "$(sed -n '1p' "$cells")" ] || {
        echo 'cockswain: existing cell ledger has an incompatible schema' >&2; exit 65;
    }
    cut -f1 "$cell_ledger" | tail -n +2 | while IFS= read -r prior_id; do
        awk -F '\t' -v id="$prior_id" '$1==id {found=1} END {exit !found}' "$cells" || {
            echo 'cockswain: a prior owner obligation disappeared on refresh' >&2
            exit 65
        }
    done
fi

collection_digest=$(digest "$collection")
scan_receipt=$state_directory/scans/$collection_digest.tsv
if [ ! -f "$scan_receipt" ]; then
    temporary_attempts=$attempt_ledger.$$.tmp
    temporary_cells=$cell_ledger.$$.tmp
    cp "$attempts" "$temporary_attempts"
    cp "$cells" "$temporary_cells"
    mv "$temporary_attempts" "$attempt_ledger"
    mv "$temporary_cells" "$cell_ledger"
    {
        printf 'schema\tcockswain-owner-scan-receipt-v1\n'
        printf 'collection_sha256\t%s\n' "$collection_digest"
        printf 'owner\t%s\n' "$owner"
        printf 'owner_revision\t%s\n' "$owner_revision"
        printf 'cell_count\t%s\n' "$observed_cells"
        printf 'attempt_count\t%s\n' "$observed_attempts"
    } > "$scan_receipt.$$.tmp"
    mv "$scan_receipt.$$.tmp" "$scan_receipt"
fi

selected=$(awk -F '\t' '
    NR==1 {next}
    $9=="FAILED" {priority=10; reason="OWNER_FAILURE"}
    $9=="ACTIONABLE" {priority=20; reason="ACTIONABLE_OWNER_CELL"}
    $9=="WAITING" {priority=30; reason="OWNER_DEPENDENCY_UNAVAILABLE"}
    $9=="HUMAN" {priority=40; reason="OWNER_PHYSICAL_OR_AUTHORITY_BOUNDARY"}
    priority {print priority "\t" reason "\t" $1 "\t" $19 "\t" $8; priority=0}
' "$cells" | LC_ALL=C sort -t "$tab" -k1,1n -k3,3 | sed -n '1p')

if [ -z "$selected" ]; then
    action=DONE
    reason=OWNER_SCOPE_COMPLETE
    cell_id=-
    next_action=-
    boundary=-
else
    priority=$(printf '%s\n' "$selected" | cut -f1)
    reason=$(printf '%s\n' "$selected" | cut -f2)
    cell_id=$(printf '%s\n' "$selected" | cut -f3)
    next_action=$(printf '%s\n' "$selected" | cut -f4)
    boundary=$(printf '%s\n' "$selected" | cut -f5)
    case "$priority" in
        10|20) action=CONTINUE ;;
        30) action=WAIT ;;
        40) action=HUMAN ;;
        *) echo 'cockswain: invalid owner decision priority' >&2; exit 65 ;;
    esac
fi

printf 'action\t%s\n' "$action"
printf 'reason_code\t%s\n' "$reason"
printf 'cell_id\t%s\n' "$cell_id"
printf 'next_action\t%s\n' "$next_action"
printf 'evidence_boundary\t%s\n' "$boundary"
printf 'owner\t%s\n' "$owner"
printf 'owner_revision\t%s\n' "$owner_revision"
printf 'owner_locator\t%s\n' "$owner_locator"
printf 'collection_sha256\t%s\n' "$collection_digest"
printf 'cell_count\t%s\n' "$observed_cells"
printf 'attempt_count\t%s\n' "$observed_attempts"
printf 'scan_receipt\t%s\n' "$scan_receipt"
